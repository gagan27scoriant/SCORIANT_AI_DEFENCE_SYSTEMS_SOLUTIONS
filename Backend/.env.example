# Server Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Recipient Email
RECEIVER_EMAIL=info@scoriant.com

# SMTP Mail Server Configuration
# Examples:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Outlook/Office365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
# Custom Domain / AWS SES / SendGrid:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM_NAME="Scoriant Systems Notification"
SMTP_FROM_EMAIL=no-reply@scoriant.com
